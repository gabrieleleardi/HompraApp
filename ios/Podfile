require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

ENV['RCT_NEW_ARCH_ENABLED'] = podfile_properties['newArchEnabled'] == 'true' ? '1' : '0'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] = podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']

platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'
install! 'cocoapods',
  :deterministic_uuids => false

prepare_react_native_project!

target 'Hompra' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => podfile_properties['apple.ccacheEnabled'] == 'true',
    )

    # This is necessary for Xcode 14, because it signs resource bundles by default
    # when building for devices.
    installer.target_installation_results.pod_target_installation_results
      .each do |pod_name, target_installation_result|
      target_installation_result.resource_bundle_targets.each do |resource_bundle_target|
        resource_bundle_target.build_configurations.each do |config|
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        end
      end
    end

    # Workaround Xcode 16.3+ / clang strict consteval ─────────────────────────
    # Errore: "Call to consteval function 'fmt::basic_format_string<...>'"
    # Causa: fmt 9.x (bundlato con RN 0.76 via Hermes/folly/glog) usa consteval
    # con default-args in modi che il clang di Xcode 16.3 rifiuta.
    # Fix: definiamo FMT_USE_CONSTEVAL=0 (fmt ricade su constexpr) e
    # FMT_USE_NONTYPE_TEMPLATE_ARGS=0 (evita ulteriori percorsi consteval).
    # È sicuro: ricalca la stessa toolchain usata su Xcode <16.3.
    fmt_defines = %w[FMT_USE_CONSTEVAL=0 FMT_USE_NONTYPE_TEMPLATE_ARGS=0]

    # 1) Applica le define a livello di build_settings di TUTTI i pod target.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
        defs = [defs] unless defs.is_a?(Array)
        fmt_defines.each do |d|
          defs << d unless defs.include?(d)
        end
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
      end
    end

    # 2) CocoaPods scrive degli xcconfig in "Pods/Target Support Files/<Pod>/<Pod>.<config>.xcconfig"
    #    che hanno la precedenza sui build_settings del target — soprattutto per i pod
    #    che compilano file C++ "puri" come fmt. Iniettiamo le define anche lì,
    #    cosi' sono visibili al compilatore senza ambiguità.
    require 'pathname'
    pods_root = Pathname.new(installer.sandbox.root.to_s)
    Dir.glob(pods_root.join('Target Support Files/**/*.xcconfig').to_s).each do |xcconfig_path|
      contents = File.read(xcconfig_path)
      injected = contents.dup
      fmt_defines.each do |d|
        next if injected.include?(d)
        if injected =~ /^GCC_PREPROCESSOR_DEFINITIONS\s*=\s*(.*)$/
          injected.sub!(/^GCC_PREPROCESSOR_DEFINITIONS\s*=\s*(.*)$/) do
            existing = Regexp.last_match(1).strip
            existing.empty? ? "GCC_PREPROCESSOR_DEFINITIONS = $(inherited) #{d}" : "GCC_PREPROCESSOR_DEFINITIONS = #{existing} #{d}"
          end
        else
          injected += "\nGCC_PREPROCESSOR_DEFINITIONS = $(inherited) #{d}\n"
        end
      end
      File.write(xcconfig_path, injected) if injected != contents
    end

    # 3) Patch DIRETTA del sorgente fmt/base.h.
    #    fmt 9.x ridefinisce FMT_USE_CONSTEVAL internamente con #if/#elif/#else
    #    (senza #ifndef), quindi la define da xcconfig non basta. Iniettiamo
    #    un #undef + #define 0 subito dopo il blocco di auto-detection, prima
    #    che la macro venga usata per dichiarare FMT_CONSTEVAL.
    fmt_base = pods_root.join('fmt/include/fmt/base.h').to_s
    if File.exist?(fmt_base)
      src = File.read(fmt_base)
      marker = '// Workaround Xcode 16.3+ clang strict consteval'
      unless src.include?(marker)
        # Inseriamo il blocco subito dopo l'ultimo #endif del blocco di detection
        # di FMT_USE_CONSTEVAL, prima della riga "#if FMT_USE_CONSTEVAL".
        patched = src.sub(
          /(#  define FMT_USE_CONSTEVAL 0\n#endif\n)(#if FMT_USE_CONSTEVAL\n)/,
          "\\1#{marker} (Hompra mobile build).\n" \
          "// Forza il fallback a empty (== regolare constexpr/inline): nessun impatto runtime.\n" \
          "#undef FMT_USE_CONSTEVAL\n" \
          "#define FMT_USE_CONSTEVAL 0\n" \
          "\\2"
        )
        if patched != src
          File.write(fmt_base, patched)
          puts "[Hompra Podfile] Patched fmt/base.h to disable FMT_USE_CONSTEVAL"
        else
          puts "[Hompra Podfile] WARNING: pattern non trovato in fmt/base.h — verifica manuale necessaria"
        end
      end
    end
  end
end
